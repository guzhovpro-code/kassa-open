# Копия этого файла - .env (права 600, в git не попадает). Значения заполняет владелец.
# Обязательные:
KASSA_BOT_TOKEN=
KASSA_ALLOWED_IDS=
KASSA_PUBLIC_URL=
KASSA_INTERNAL_TOKEN=

# Необязательные (пустое значение = по умолчанию):
# адрес мини-приложения: добавить длинный случайный префикс пути (не короче 32 знаков A-Za-z0-9_-)
KASSA_PATH_TOKEN=
# часовой пояс «дня» (имя IANA), по умолчанию UTC
KASSA_TZ=
# вечернее напоминание, если за день нет записей: 1 - включить
KASSA_REMINDER_ENABLED=
# время напоминания ЧЧ:ММ в поясе KASSA_TZ, по умолчанию 21:30
KASSA_REMINDER_TIME=
# голос: local (по умолчанию, faster-whisper на этой машине), groq (облако Groq, нужен ключ ниже, звук уходит в Groq)
# или off (без голоса). Пусто = local; старое KASSA_VOICE_ENABLED=0 без этой переменной означает off
KASSA_VOICE_PROVIDER=
# модель local: tiny (самая лёгкая, для слабой машины), base, small (по умолчанию), medium
KASSA_WHISPER_MODEL=
# ключ Groq (бесплатный, console.groq.com) и модель для KASSA_VOICE_PROVIDER=groq; по умолчанию whisper-large-v3-turbo
KASSA_GROQ_API_KEY=
KASSA_GROQ_MODEL=
# 0 = собирать образ без faster-whisper (для groq и off; local тогда не работает); по умолчанию 1
INSTALL_WHISPER=
# пользователь контейнеров = владелец папки data (id -u и id -g), по умолчанию 10001
KASSA_UID=
KASSA_GID=
