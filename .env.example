# Копия этого файла - .env (права 600, в git не попадает). Значения заполняет владелец.
# Обязательные:
KASSA_BOT_TOKEN=
KASSA_ALLOWED_IDS=
KASSA_PUBLIC_URL=
KASSA_INTERNAL_TOKEN=

# Необязательные (пустое значение = по умолчанию):
# адрес мини-приложения: добавить длинный случайный префикс пути (не короче 32 знаков A-Za-z0-9_-)
KASSA_PATH_TOKEN=
# часовой пояс «дня» (имя IANA), по умолчанию UTC
KASSA_TZ=
# вечернее напоминание, если за день нет записей: 1 - включить
KASSA_REMINDER_ENABLED=
# время напоминания ЧЧ:ММ в поясе KASSA_TZ, по умолчанию 21:30
KASSA_REMINDER_TIME=
# голосовые сообщения: 1 (по умолчанию) - расшифровывать, 0 - выключить
KASSA_VOICE_ENABLED=
# модель faster-whisper: tiny, base, small (по умолчанию), medium
KASSA_WHISPER_MODEL=
# пользователь контейнеров = владелец папки data (id -u и id -g), по умолчанию 10001
KASSA_UID=
KASSA_GID=
